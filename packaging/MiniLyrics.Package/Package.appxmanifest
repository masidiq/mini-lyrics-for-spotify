<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="19108TheRusun.MiniLyricsforSpotifyDesktop"
            Publisher="CN=A13B6398-8001-4158-A92C-2EA07BE0669D"
            Version="0.1.7.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Mini Lyrics for Spotify Desktop</DisplayName>
    <PublisherDisplayName>The Rusun</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="id-ID" />
  </Resources>
  <Applications>
    <Application Id="MiniLyricsForSpotify" Executable="MiniLyrics.App\MiniLyricsForSpotify.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Mini Lyrics for Spotify Desktop"
                          Description="Lirik mengambang untuk Spotify Desktop"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="MiniLyrics.App\MiniLyricsForSpotify.exe" />
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>


